NEXT_PUBLIC_API_URL=http://localhost:3010/api/v1
NEXT_PUBLIC_USE_MOCKS=true
# Comma-separated modules that call the real API even when mocks are on: auth, expense, planning, schedule, board
NEXT_PUBLIC_REAL_API_MODULES=auth
# Set to true to make ~5% of mock requests fail (to test error states and rollback)
NEXT_PUBLIC_MOCK_ERRORS=false
